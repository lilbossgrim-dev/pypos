PYPOS_DATABASE_URL=postgresql+psycopg://pypos:CHANGE_ME@localhost:5432/pypos
PYPOS_CURRENCY=MXN
PYPOS_TIMEZONE=America/Mexico_City
PYPOS_MERCHANT_ID=default
# Required for API tokens: at least 32 random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PYPOS_SECRET_KEY=
# Production: apply migrations with `pypos db-upgrade` instead of auto-creating tables
PYPOS_AUTO_CREATE_SCHEMA=false

# docker compose only
POSTGRES_PASSWORD=
